# ── 이 파일을 .env 로 복사해서 사용 (copy .env.example .env) ──
# 키 이름은 app/core/config.py 의 Settings 와 1:1 (대소문자 무관). 여기 없는 키는 Settings 기본값.
# 비밀값(JWT_SECRET, REDIS_PASSWORD)은 자리표시자다 — 실제 값은 .env 에만 둔다(.env 는 커밋 금지).

# ── 실행 환경: dev | prod ──
# prod 면 아래 중 하나라도 해당할 때 api·worker 가 기동을 거부한다(명확한 에러 메시지와 함께):
#   JWT_SECRET 이 자리표시자이거나 32자 미만 / FIREBASE_MODE=fake / SEED_ON_STARTUP=true
# 또 prod 에서는 콘솔 메일(EMAIL_MODE=console)이 본문(재설정 링크·토큰)을 로그에 남기지 않는다.
# docker-compose.prod.yml 은 이 값을 prod 로 강제한다. 로컬 개발은 dev.
APP_ENV=dev

# ── DB ──
# 기본 = docker-compose.yml 의 db 컨테이너(127.0.0.1:5433). `docker compose up -d db redis` 로 바로 뜬다.
# (선택) 호스트에 네이티브 PostgreSQL 을 쓰면 포트·DB 이름만 바꾼다. 예: localhost:5432
# 앱 런타임은 async 드라이버(asyncpg), Alembic·backup.bat 은 sync URL(psycopg2)을 쓴다.
DATABASE_URL=postgresql+asyncpg://glitch:glitch@localhost:5433/glitch_integrated
DATABASE_URL_SYNC=postgresql+psycopg2://glitch:glitch@localhost:5433/glitch_integrated

# ── 인증(JWT) ──
# 아래는 공개된 자리표시자 — APP_ENV=prod 면 기동 거부. 배포용 값 생성(32자 이상):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 파이프라인 주입 모드: fake | weave | local | remote | replay ──
# weave: Weave 엔진(추출 → 엔티티 레지스트리 → 원장 재생 → 규칙 검사 → LLM 판정 k회)을 서버 안에서 실행. 아래 WEAVE_* 참조
# replay: 시연용. app/pipeline/replay_data/<작품>/chapter_N.txt 를 N화로 올리면 미리 만든 AI 결과가 나온다
#   작품은 REPLAY_STORY: inception(1~3화) | interstellar(1~2화)
# fake: 고정 예시 결과(외부 의존 없음) | remote: AI 서버(ai_server/, 기본 http://127.0.0.1:8100)
PIPELINE_MODE=fake
# remote 모드일 때만 사용. 예: http://127.0.0.1:8100
PIPELINE_REMOTE_URL=
# remote 모드: 추출·검수 HTTP 요청 1건 상한(초). 시간 사슬: LLM 1회 < 이 값 < JOB_TIMEOUT_SECONDS
# 검수는 LLM 최대 2회(추출 보충) + 임베딩 → AI 서버 ANTHROPIC_TIMEOUT_SECONDS(420)×2 + 120 = 960.
# OpenRouter(OPENROUTER_TIMEOUT_SECONDS=540)면 540×2 + 120 = 1200, JOB_TIMEOUT_SECONDS 는 1500.
PIPELINE_TIMEOUT_SECONDS=960
# remote 모드: AI 서버가 echo(고정 샘플)면 분석을 거부한다. 배선 확인할 때만 true
PIPELINE_ALLOW_ECHO=false
# remote 모드: AI 서버 공유 토큰(ai_server/.env 의 AI_SERVER_TOKEN 과 같은 값). 비우면 인증 없음 — 로컬 전용
PIPELINE_REMOTE_TOKEN=
# ── weave 모드 설정 (PIPELINE_MODE=weave 일 때만) ──
# 작품별 내부 상태(레지스트리·회차별 사건 로그·판정 원문) 저장 위치. DB 와 같은 시점으로 백업할 것
WEAVE_DATA_DIR=weave_data
# LLM 백엔드: openrouter | nim | anthropic
WEAVE_LLM_PROVIDER=openrouter
# 기본 = Weave 무료 열 측정 모델. 무료(:free)는 계정당 하루 50회 남짓 — 서비스 운영에는 유료 모델 권장
WEAVE_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# 역할별 모델(비우면 WEAVE_LLM_MODEL)
WEAVE_EXTRACT_MODEL=
WEAVE_JUDGE_MODEL=
# provider 의 API 키. 비우면 OPENROUTER_API_KEY / NVIDIA_API_KEY / ANTHROPIC_API_KEY 환경변수를 쓴다
WEAVE_API_KEY=
WEAVE_MAX_TOKENS=8192
WEAVE_TEMPERATURE=0.2
# openrouter 전용: reasoning 끔(측정 조건과 동일)
WEAVE_REASONING_OFF=true
# 판정 반복 횟수와 다수결 기준. 1회 판정은 정상 장면에서 평균 10% 오탐 → 3 권장
WEAVE_JUDGE_K=3
WEAVE_JUDGE_MAJORITY=2
# 판정 패킷 단위: scene | event | both(호출 2배)
WEAVE_JUDGE_UNIT=scene
# 판정 호출 동시 실행 수(장면 수 × K 전체를 한 풀에서). 1 = 하나씩. 무료 한도는 분당 20회
WEAVE_JUDGE_CONCURRENCY=3
# 과거 사건 제공 방식: full(확정 사건 전량) | ers(관련 top-5 검색) | full_source
WEAVE_RETRIEVAL=full
# 추출 분할 크기(자). 회차가 이보다 길면 문단 경계로 나눠 조각마다 추출한다.
# nemotron 무료 열의 측정 조건은 2500 — 5000이면 응답(8192토큰)이 잘려 추출이 실패한다
WEAVE_CHUNK_CHARS=2500
# 화면에 올릴 LLM 판정의 최소 검출률(k=3 이면 0.34 = 3회 중 1회 이상)
WEAVE_MIN_DETECTION_RATE=0.34
# 추출 관문: 추출 결과를 확정/잠정으로 등급 매긴다(validator 경고·미해결 NEW: 라벨·from=unknown).
# 검수 원장: off(등급 무시) | annotate(원장 그대로, 잠정 사건만 기록) | exclude(잠정 사실을 원장에서 뺌)
WEAVE_GATE_MODE=off
# 추출 검증기(LLM 0회): off | annotate(등급 파일에 표시 신호·승격 후보만 더함, 등급 불변). GATE_MODE=off 면 무시
WEAVE_VERIFIER=off
WEAVE_GATE_UNKNOWN_FROM=true
# 판정기: llm(LLM k회) | learned(학습 judge, 판정 LLM 0회 — k=1·majority=1 강제, WEAVE_JUDGE_K 무시)
WEAVE_JUDGE_MODE=llm
# learned 백엔드: hf(transformers, pip install -e .[judge]) | fake(결정적 휴리스틱, 테스트용)
WEAVE_JUDGE_BACKEND=hf
# hf 모델 폴더(scripts/train_judge.py 출력, 저장소 밖)
WEAVE_JUDGE_MODEL_DIR=
# 모순 확률 기준값. 주석이면 모델 폴더 judge_meta.json 의 값(없으면 0.5)
# WEAVE_JUDGE_THRESHOLD=0.5
WEAVE_JUDGE_BATCH_SIZE=16
# hf 추론 결정성: 같은 기계·같은 설정에서 비트 동일 목표. 스레드 수(주석이면 torch 기본, interop 은 1 고정)
# WEAVE_JUDGE_THREADS=4
# 비우면 모델 폴더 judge_meta.json 의 max_length·padding(학습과 같은 조건). 정밀도(GPU fp16·CPU fp32)·어텐션(eager)도 meta
# WEAVE_JUDGE_MAX_LENGTH=384
# bucket(길이 버킷 128/256/384/512 패딩) | max_length(모든 쌍을 MAX_LENGTH 로)
# WEAVE_JUDGE_PADDING=bucket
# auto(cuda 있으면 cuda) | cpu | cuda. GPU 면 워커 환경에 CUBLAS_WORKSPACE_CONFIG=:4096:8 을 미리 넣을 것
WEAVE_JUDGE_DEVICE=auto
# 호출량(회차 1개): 추출 = 조각 수, 검수 = 장면 수 × WEAVE_JUDGE_K. 무료 모델은 느려서
# 아래 JOB_TIMEOUT_SECONDS 를 3600 이상으로 올릴 것
# LLM 호출 녹화·재생(평가·회귀 게이트용, 운영은 off): off | record(호출하고 ok 응답을 남김) | replay(녹화본만, 네트워크 0회,
# 녹화에 없는 호출이면 즉시 실패). 키 = 역할 + sha256(프롬프트)
WEAVE_LLM_RECORD=off
WEAVE_LLM_RECORD_DIR=weave_llm_record

# replay 모드일 때만 사용. 추출·검수 단계마다 기다리는 시간(초)
REPLAY_DELAY_SECONDS=3

# ── 분석 작업 큐 (arq 고정. inline 은 테스트 전용) ──
# 워커: python -m arq app.workers.worker.WorkerSettings (start_integrated.bat 이 같이 띄움)
QUEUE_MODE=arq
# Redis 비밀번호 — 필수. docker-compose.yml 이 requirepass 로 쓰고(없으면 기동 거부),
# REDIS_URL 에도 같은 값을 넣는다. 호스트는 127.0.0.1 (compose 가 IPv4 루프백에만 연다 — localhost=::1 이면 멈춤).
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
# arq 작업 1건 상한(초). PIPELINE_TIMEOUT_SECONDS 보다 넉넉하게(워커가 기동 때 순서를 점검해 경고)
JOB_TIMEOUT_SECONDS=1200
# 워커 동시 분석 수. CPU 임베딩(배포 VM)은 2, GPU 개발 PC 는 4 까지
WORKER_MAX_JOBS=2
# 진행 중(extracting/reviewing) 회차가 이 시간(분) 넘게 그대로면 워커가 죽은 것으로 보고,
# 새 분석 요청이 오면 failed("시간 초과로 중단된 작업")로 기록한 뒤 받아준다.
# 실제 기준은 max(ANALYSIS_STALE_MINUTES, JOB_TIMEOUT_SECONDS/60 + 5) — 기본값(1200초)이면 25분.
ANALYSIS_STALE_MINUTES=20

# ── CORS — 프론트를 다른 오리진에서 띄울 때만(쉼표 구분). 같은 오리진(/) 서빙이면 불필요 ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── 앱 시작 시 데모 시드(cho@example.com / glitch123, 금도끼 은도끼 예시) 주입 여부 ──
# Settings 기본값은 false — 로컬 개발 편의로 여기서 켠다. 이 비밀번호는 README 에 공개돼 있으므로
# 공개 URL·배포에서는 반드시 false(APP_ENV=prod 에서 true 면 기동 거부). 이미 만들어진 계정은 남는다.
SEED_ON_STARTUP=true

# ── 기능 플래그 (끄면 해당 API 자체가 사라짐, 기본 false) ──
# 구독·공유·채팅·알림은 프론트가 부르지 않는 미완성 API 다. 구독은 PUT /me/subscription 으로
# 누구나 pro 가 되고 plan 이 실제로 막는 기능은 없다(표시용) — 공개 배포에서는 false 로 둔다.
ENABLE_SUBSCRIPTION=false
ENABLE_SHARING=false
ENABLE_CHAT=false
ENABLE_NOTIFICATIONS=false
# /docs·/redoc·/openapi.json. 배포는 false(docker-compose.prod.yml 이 강제)
ENABLE_API_DOCS=true

# ── Firebase 구글 로그인 연동 (프론트의 로그인) ──
# FIREBASE_MODE: google(실검증) | fake(fake:<email> 토큰을 무검증 통과 — 로컬 데모 전용, 공개 URL 금지)
# 데모 로그인(?demo=1)을 쓰려면 fake 로 바꾼다.
ENABLE_FIREBASE_AUTH=true
FIREBASE_MODE=google
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── 시연 계정(읽기 전용) — 시작 화면 "시연 계정으로 둘러보기" ──
# 켜면 DEMO_ACCOUNT_EMAIL 계정 하나에만 구글 인증 없이 로그인시켜 주고, 그 계정은 조회만 가능하다.
# 계정은 DB에 미리 있어야 한다. 녹화 스크립트처럼 그 계정으로 쓰기가 필요할 땐 false.
ENABLE_DEMO_ACCOUNT=false
DEMO_ACCOUNT_EMAIL=demo@glitch.local

# ── 접속 제한 (개발진 전용 배포 등) ──
# 허용 이메일(쉼표 구분, 대소문자 무관). 비우면 누구나. 목록 밖 계정은 로그인·가입 403,
# 이미 받은 토큰도 막힌다(계정을 만들기 전에 거부). 켜져 있는 시연 계정은 예외.
ALLOWED_EMAILS=
# 이메일·비밀번호 방식(/auth/register·login·forgot-password·reset-password). false 면 404 — 구글 로그인만.
# 재설정 메일은 EMAIL_MODE=console 이라 실제로 발송되지 않는다 → 배포에서는 false 권장.
ENABLE_PASSWORD_AUTH=true

# ── 레이트리밋(분당, IP별) — 0이면 끔 ──
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=30
# 클라이언트 IP 를 읽을 헤더 — 앞단 프록시가 덮어쓰는 헤더만(Caddy/nginx: x-real-ip, cloudflared: cf-connecting-ip).
# 비우면 접속 IP. 프록시 없이 헤더를 믿으면 요청마다 IP 를 지어내 레이트리밋을 우회할 수 있다.
# 프록시 뒤인데 비워 두면 모든 사용자가 127.0.0.1 한 칸을 나눠 쓴다. start_tunnel.bat 은 cf-connecting-ip 로 띄운다.
TRUSTED_CLIENT_IP_HEADER=

# ── 회차 업로드 ──
ALLOWED_CHAPTER_EXTS=txt,docx,md,pdf
# 파일 상한(바이트, 10MB) / 추출·입력 텍스트 상한(글자 수)
MAX_UPLOAD_BYTES=10485760
MAX_CHAPTER_CHARS=500000
# 프로젝트 썸네일 이미지 상한(바이트, 5MB). PNG·JPEG·GIF·WebP 만 받는다
MAX_THUMBNAIL_BYTES=5242880

# ── 교체 가능 인프라 ──
# EMAIL_MODE: console | smtp(추후)   STORAGE_MODE: local | s3(추후)   CHAT_MODE: fake | remote(추후)
EMAIL_MODE=console
STORAGE_MODE=local
# 썸네일/파일 저장 루트(local)
UPLOAD_DIR=uploads
CHAT_MODE=fake
# 재설정/공유 링크에 쓰는 외부 접근 URL (터널을 열면 그 주소로)
PUBLIC_BASE_URL=http://localhost:8000
RESET_TOKEN_EXPIRE_MINUTES=60

# ── 배포(docker-compose.prod.yml) 전용 — 없으면 compose 가 기동을 거부한다 ──
# prod 오버레이가 DATABASE_URL·REDIS_URL·PIPELINE_REMOTE_URL·PIPELINE_REMOTE_TOKEN 을 컨테이너 기준으로 덮어쓴다.
# DB 비밀번호는 URL 에 들어가므로 영문·숫자만 쓴다(특수문자는 URL 인코딩 문제).
# POSTGRES_PASSWORD=
# 몸통·AI 서버 공유 토큰. 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AI_SERVER_TOKEN=
# AI 서버가 VM 밖(개발 PC)에 있을 때만 — 그 PC 의 tailnet IP 와 포트(ai_server/run_deploy.bat 은 8101).
# 비우면 같은 VM 의 ai 컨테이너(http://ai:8100). MagicDNS 이름은 컨테이너 안에서 안 풀릴 수 있어 IP 를 쓴다.
# 절차: docs/deploy_split_ai.md
# AI_SERVER_URL=http://100.101.102.103:8101
